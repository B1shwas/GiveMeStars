// This is your Prisma schema file
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Core user model
model User {
  id         String   @id @unique @default(uuid())
  username   String   @unique
  password   String
  fullname   String
  email      String?  @unique
  roles      Int[] // Array of role codes
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  contactId String?      @unique
  contact   UserContact? @relation(fields: [contactId], references: [id])
  schoolId  String?

  // Feedback system
  feedbacks         Feedback[] // Feedbacks given
  receivedFeedbacks Feedback[] @relation("receivedFeedbacks")

  // Authentication
  refreshTokens RefreshToken[]
  schools       School[]       @relation("UserSchools")
  createdSchool School[]       @relation("CreatedSchools")

  @@index([username])
  @@index([email])
}

// Location hierarchy
model Country {
  id     String  @id @unique @default(uuid())
  name   String  @unique
  code   String  @unique
  states State[]
}

model State {
  id        String  @id @unique @default(uuid())
  name      String
  code      String
  countryId String
  country   Country @relation(fields: [countryId], references: [id])
  cities    City[]

  @@unique([code, countryId])
}

model City {
  id       String    @id @unique @default(uuid())
  name     String
  stateId  String
  state    State     @relation(fields: [stateId], references: [id])
  pincodes Pincode[]

  @@unique([name, stateId])
}

model Pincode {
  id             String          @id @unique @default(uuid())
  code           String
  cityId         String
  city           City            @relation(fields: [cityId], references: [id])
  userContacts   UserContact[]
  schoolContacts SchoolContact[]

  @@unique([code, cityId])
}

// Contact information
model UserContact {
  id         String   @id @unique @default(uuid())
  phone      String?
  address    String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Location
  pincodeId String?
  pincode   Pincode? @relation(fields: [pincodeId], references: [id])

  // Relation
  user User?
}

// School information
model School {
  id          String   @id @unique @default(uuid())
  name        String
  description String?
  created_at  DateTime @default(now())

  // Relations
  contactId String        @unique
  contact   SchoolContact @relation(fields: [contactId], references: [id])
  createdBy String
  creator   User          @relation("CreatedSchools", fields: [createdBy], references: [id])
  users     User[]        @relation("UserSchools")

  @@index([name])
}

model SchoolContact {
  id         String   @id @unique @default(uuid())
  email      String   @unique
  phone      String
  address    String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Location
  pincodeId String
  pincode   Pincode @relation(fields: [pincodeId], references: [id])

  // Relation
  school School?
}

// Feedback system
model Feedback {
  id         String   @id @unique @default(uuid())
  rating     Float?
  review     String?
  reply      String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  giverId    String
  giver      User   @relation(fields: [giverId], references: [id])
  receiverId String
  receiver   User   @relation("receivedFeedbacks", fields: [receiverId], references: [id])

  @@unique([giverId, receiverId])
  @@index([giverId])
  @@index([receiverId])
}

// Authentication
model RefreshToken {
  id        String   @id @unique @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([token])
}
