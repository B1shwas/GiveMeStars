// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @unique @default(uuid())
  username     String     @unique
  password     String
  fullname     String
  role         ROLE       @default(STUDENT)
  email        String?    @unique
  created_at   DateTime   @default(now())
  updated_at   DateTime   @updatedAt
  students     Student[]  @relation("students")
  teachers     Teacher[]  @relation("teachers")
  refreshToken String[]
  feedbacks    Feedback[] // Combined feedback (ratings and reviews)
}

model School {
  id         String    @id @unique @default(uuid())
  name       String
  address    String
  created_at DateTime  @default(now())
  students   Student[]
  teachers   Teacher[]
}

model Student {
  id         String     @id @unique @default(uuid())
  userId     String     @unique
  schoolId   String?
  grade      String?
  created_at DateTime   @default(now())
  user       User       @relation("students", fields: [userId], references: [id])
  school     School?    @relation(fields: [schoolId], references: [id])
  feedbacks  Feedback[] // Combined feedback
}

model Teacher {
  id        String     @id @unique @default(uuid())
  userId    String     @unique
  schoolId  String?
  subject   String?
  bio       String?
  feedbacks Feedback[] // Combined feedback
  user      User?      @relation("teachers", fields: [userId], references: [id])
  school    School?    @relation(fields: [schoolId], references: [id])
}

model Feedback {
  id        String  @id @unique @default(uuid())
  rating    Float? // Optional rating
  review    String? // Optional review
  teacherId String?
  studentId String?
  userId    String?

  Teacher Teacher? @relation(fields: [teacherId], references: [id])
  Student Student? @relation(fields: [studentId], references: [id])
  User    User?    @relation(fields: [userId], references: [id])

  @@unique([teacherId, studentId, userId]) // Unique constraint to prevent duplicate feedback from the same user
}

enum ROLE {
  STUDENT
  TEACHER
  ADMIN
}
