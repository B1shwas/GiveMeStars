// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @unique @default(uuid())
  username     String     @unique
  password     String
  fullname     String
  email        String?    @unique
  created_at   DateTime   @default(now())
  updated_at   DateTime   @updatedAt
  students     Student[]  @relation("students")
  teachers     Teacher[]  @relation("teachers")
  refreshToken String[]
  feedbacks    Feedback[] // Combined feedback (ratings and reviews)
  roles        Role[]     @relation("User  Roles")
  School       School[]

  @@index([username]) // Index for fast username lookups
  @@index([email]) // Index for fast email lookups
}

model School {
  id          String    @id @unique @default(uuid())
  name        String
  address     String
  email       String    @unique
  state       String
  country     String
  city        String
  pincode     String
  phone       String
  passcode    String
  description String?
  created_at  DateTime  @default(now())
  createdBy   String
  creator     User      @relation(fields: [createdBy], references: [id])
  students    Student[]
  teachers    Teacher[] @relation("schoolTeachers")
  admins      Teacher[] @relation("schoolAdmins")
  moderators  Teacher[] @relation("schoolModerators")

  @@index([name]) // Index for fast school name lookups
}

model Student {
  id         String     @id @unique @default(uuid())
  userId     String     @unique
  schoolId   String?
  grade      String?
  created_at DateTime   @default(now())
  user       User       @relation("students", fields: [userId], references: [id])
  school     School?    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  feedbacks  Feedback[] // Combined feedback

  @@index([userId]) // Index for fast userId lookups
  @@index([schoolId]) // Index for fast schoolId lookups
}

model Role {
  id       String @id @unique @default(uuid())
  name     String @unique
  roleCode String @unique
  users    User[] @relation("User  Roles")

  @@index([name]) // Index for fast role name lookups
}

model Teacher {
  id        String     @id @unique @default(uuid())
  userId    String     @unique
  schoolId  String?
  subject   String?
  bio       String?
  feedbacks Feedback[] // Combined feedback
  user      User?      @relation("teachers", fields: [userId], references: [id], onDelete: Cascade)

  // Unique map attributes for each relation
  school          School? @relation("schoolTeachers", fields: [schoolId], references: [id], map: "teacher_school_relation")
  adminSchool     School? @relation("schoolAdmins", fields: [schoolId], references: [id], map: "teacher_admin_school_relation")
  moderatorSchool School? @relation("schoolModerators", fields: [schoolId], references: [id], map: "teacher_moderator_school_relation")

  @@index([userId]) // Index for fast userId lookups
  @@index([schoolId]) // Index for fast schoolId lookups
}

model Feedback {
  id        String  @id @unique @default(uuid())
  rating    Float? // Optional rating
  review    String? // Optional review
  reply     String?
  teacherId String?
  studentId String?
  userId    String?

  Teacher Teacher? @relation(fields: [teacherId], references: [id])
  Student Student? @relation(fields: [studentId], references: [id])
  User    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teacherId, studentId, userId]) // Unique constraint to prevent duplicate feedback from the same user
  @@index([teacherId]) // Index for fast teacherId lookups
  @@index([studentId]) // Index for fast studentId lookups
  @@index([userId]) // Index for fast userId lookups
}
